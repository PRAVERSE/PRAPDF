    "@types/jpeg-js": "^0.3.0",
    "jpeg-js": "^0.4.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lucide": "^0.460.0",
    "markdown-it": "^14.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.4",
    "playwright": "^1.64.0",
