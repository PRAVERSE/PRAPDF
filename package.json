{
  "name": "pra-pdf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PRA PDF by PRAVERSE — Professional Online PDF & Document Toolkit",
  "scripts": {
    "dev": "vite",
    "server": "tsx src/server/server.ts",
    "processor": "tsx src/processor/server.ts",
    "build": "tsc && vite build",
