# Dedicated Heavy Processing Server
PROCESSOR_BASE_URL=
PROCESSOR_HOST=127.0.0.1
PROCESSOR_PORT=3002
PROCESSOR_SHARED_SECRET=
PROCESSOR_MAX_FILE_SIZE_MB=50
PROCESSOR_MAX_CONCURRENCY=1
PROCESSOR_TIMEOUT_SECONDS=300
