# PRA PDF — Environment Configuration Template
# A PRAVERSE Company
# Copy this file to .env and supply your credentials. Never commit real credentials!

PRA_ENV=development
PORT=3001
MAX_FILE_SIZE_MB=50

# Backblaze B2 Provider 1
B2_1_ENDPOINT=
B2_1_REGION=
B2_1_BUCKET_ID=
B2_1_BUCKET_NAME=
B2_1_KEY_ID=
B2_1_APPLICATION_KEY=

# Backblaze B2 Provider 2 (Primary Default Bucket)
B2_2_ENDPOINT=
B2_2_REGION=
B2_2_BUCKET_ID=
B2_2_BUCKET_NAME=
B2_2_KEY_ID=
B2_2_APPLICATION_KEY=

# Backblaze B2 Provider 3
B2_3_ENDPOINT=
B2_3_REGION=
B2_3_BUCKET_ID=
B2_3_BUCKET_NAME=
B2_3_KEY_ID=
B2_3_APPLICATION_KEY=

# Backblaze B2 Provider 4 (Optional)
B2_4_ENDPOINT=
B2_4_REGION=
B2_4_BUCKET_ID=
B2_4_BUCKET_NAME=
B2_4_KEY_ID=
B2_4_APPLICATION_KEY=

# Telegram Bot API Original Backup
TELEGRAM_BOT_TOKEN=
